# ==============================================================================
# CodeLens — AI Software Repository Intelligence System Configuration
# ==============================================================================

# Core Django Configuration
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production-!@#$
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL with pgvector for Docker/Production, SQLite for local host dev)
# In Docker: set automatically in docker-compose.yml
# In local host dev: leave blank to use SQLite
DATABASE_URL=
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codelens
POSTGRES_DB=codelens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery Background Workers
# For local Docker: redis://redis:6379/0 and CELERY_ALWAYS_EAGER=False
# For host local dev without Redis: set CELERY_ALWAYS_EAGER=True
REDIS_URL=
CELERY_ALWAYS_EAGER=True

# JWT Authentication
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# File Upload Limits
MAX_UPLOAD_SIZE=52428800  # 50 MB in bytes

# AI & LLM Service Abstraction
# Options: mock, openai, gemini, anthropic
# Default: 'mock' runs fully offline with deterministic cosine similarity!
AI_PROVIDER=mock
AI_MODEL_NAME=gpt-4o-mini
EMBEDDING_DIMENSION=384

# API Keys (Optional if AI_PROVIDER=mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Initial Seeding Flag
SEED_DEMO_DATA=true
